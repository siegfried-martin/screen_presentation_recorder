# Record Presentation settings.
# install.sh copies this to ~/.config/presentation-record/config.env (if missing).
# Plain KEY=value lines; $HOME and ~ are expanded.

# Where recordings and transcripts go.
# After changing it, re-run ./install.sh so the transcription worker watches the new folder.
RECORDINGS_DIR=$HOME/Videos/Presentations

# Video encoder: auto, vaapi (AMD/Intel), nvenc (NVIDIA) or x264 (software).
# Applied by ./install.sh.
ENCODER=auto

# --- read on every recording, no reinstall needed ---

# Frames per second. 15 is plenty for slides; use 30 for demos with motion.
FPS=15

# Bigger screens are scaled down to fit this size.
MAX_RESOLUTION=1920x1200

# Seconds of 3-2-1 countdown before recording starts (0 = none).
COUNTDOWN=3

# Turn on Do Not Disturb while recording so notification popups stay out of the video.
DO_NOT_DISTURB=true

# WhisperX model and spoken language for transcripts.
# Smaller/faster models: small, medium. Language codes: en, de, fr, es, ...
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=en
